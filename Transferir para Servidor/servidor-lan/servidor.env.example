# Copie para servidor.env e ajuste apenas o IP/host da máquina servidora.
# Um único lugar para trocar o endereço da LAN (build + Auth + URLs de teste).
#
# ACOMOPMS_LAN_HOST=auto  → detecta o primeiro IPv4 não-loopback (Linux/Windows script)
# ACOMOPMS_LAN_HOST=192.168.0.42  → use o IP fixo do PC servidor na rede Wi‑Fi/Ethernet

ACOMOPMS_LAN_HOST=auto
ACOMOPMS_HTTP_PORT=8080

# Supabase local permanece só no host (não publicar Postgres na LAN)
ACOMOPMS_SUPABASE_INTERNAL=http://127.0.0.1:54321
