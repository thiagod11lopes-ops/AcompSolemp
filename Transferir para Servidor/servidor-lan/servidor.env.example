# Copie para servidor.env (servidor.env não vai para o Git).
# Fonte única para build, Auth, Caddy, firewall e testes LAN/Tailscale.
#
# === Modo de acesso (ACOMOPMS_ACCESS_MODE) ===
#
# local — Rede Wi‑Fi/Ethernet na mesma LAN física:
#   ACOMOPMS_ACCESS_MODE=local
#   ACOMOPMS_LAN_HOST=auto          → scripts detectam o primeiro IPv4 não-loopback
#   ACOMOPMS_LAN_HOST=192.168.0.42  → ou IPv4 fixo do PC servidor
#   (Não use ACOMOPMS_FIREWALL_SCOPE=tailnet nem SECONDARY_LAN_REDIRECTS no modo local.)
#
# internet — Acesso remoto via Tailscale (cliente oficial), configurado pelo Servidor Manager na instalação:
#   ACOMOPMS_ACCESS_MODE=internet
#   ACOMOPMS_LAN_HOST=desktop-exemplo.tail123456.ts.net   → MagicDNS ilustrativo (*.ts.net)
#   # ou ACOMOPMS_LAN_HOST=100.64.0.99                    → IPv4 tailnet 100.64.0.0/10 (exemplo)
#   ACOMOPMS_LAN_HOST=auto ou 192.168.x NÃO são válidos com access_mode internet.
#   ACOMOPMS_FIREWALL_SCOPE=tailnet
#   ACOMOPMS_SECONDARY_LAN_REDIRECTS=auto
#   ACOMOPMS_OVERLAY_ENABLED=false
#
# Legado: omitir ACOMOPMS_ACCESS_MODE comporta-se como LAN local (auto detecta IPv4).
#
# === Valores ativos (exemplo modo local — ajuste ou use bloco internet acima) ===

ACOMOPMS_LAN_HOST=auto
ACOMOPMS_HTTP_PORT=8080

# Supabase local permanece só no host (não publicar Postgres na LAN/tailnet direto)
ACOMOPMS_SUPABASE_INTERNAL=http://127.0.0.1:54321

# --- Overlay WireGuard opcional (Etapas 5–6 do repositório) ---
# Independente do Tailscale: VPN embutida Headscale/WireGuard, NÃO é o modo "Internet" do Manager.
# Deixe false quando usar Tailscale (ACOMOPMS_ACCESS_MODE=internet).
ACOMOPMS_OVERLAY_ENABLED=false
# ACOMOPMS_OVERLAY_HOST=100.64.0.1
# ACOMOPMS_OVERLAY_SUBNET=100.64.0.0/24
# ACOMOPMS_OVERLAY_SERVER_ADDRESS=100.64.0.1/32
# ACOMOPMS_OVERLAY_HEADSCALE_URL=https://headscale.exemplo:443
# ACOMOPMS_OVERLAY_NAMESPACE=acomopms
# ACOMOPMS_OVERLAY_SERVER_NAME=servidor-omh-1
# ACOMOPMS_OVERLAY_WG_PORT=51820
# ACOMOPMS_OVERLAY_PUBLIC_ENDPOINT=udp://SEU_IP_PUBLICO:51820
# Depois de true: node configurar-overlay-servidor.mjs ou aplicar-overlay-servidor.*
