############
# AcompOPMS — servidor portátil (Windows)
# Copie para config.env e ajuste.
############

# IP ou hostname desta máquina na rede (o outro PC usa isso no navegador)
SERVER_HOST=192.168.0.17

# Portas
SUPABASE_PORT=8000
APP_PORT=5173

# Pasta do Docker Supabase self-hosted (volumes do banco ficam DENTRO dela)
# Ex.: C:\Users\User\Desktop\Thiago\Projetos\supabase-master\docker
SUPABASE_DOCKER_DIR=

# Pasta do frontend AcompSolemp
# Ex.: C:\Users\User\Desktop\Thiago\Projetos\AcompSolemp\frontend
FRONTEND_DIR=

# Credenciais do Studio (basic auth do gateway) — só na rede local
DASHBOARD_USER=supabase
DASHBOARD_PASSWORD=this_password_is_insecure_and_should_be_updated
