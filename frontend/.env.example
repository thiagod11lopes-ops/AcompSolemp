# Fonte de dados: local (IndexedDB) ou supabase
VITE_DATA_SOURCE=local

# E-mail opcional aplicado ao bootstrap de gestor/admin no seed local
VITE_GESTOR_GOOGLE_EMAIL=

# Supabase — https://supabase.com/dashboard → Project Settings → API
# (só necessários com VITE_DATA_SOURCE=supabase)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Servidor LAN (Etapa 4A): use o script build-producao-lan — define VITE_SUPABASE_URL
# como http://<IP-LAN>:8080 (API via Caddy no mesmo host). Ver:
# Transferir para Servidor/servidor-lan/servidor.env.example
