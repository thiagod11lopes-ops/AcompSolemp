# Fonte de dados: local (IndexedDB) ou supabase
VITE_DATA_SOURCE=local

# E-mail opcional aplicado ao bootstrap de gestor/admin no seed local
VITE_GESTOR_GOOGLE_EMAIL=

# Domínio institucional exigido nos cadastros/login (obrigatório em produção)
# Ex.: digite o domínio da organização no deploy / .env local
VITE_EMAIL_DOMAIN=

# E-mail do super administrador (obrigatório para funções de super-admin)
VITE_SUPER_ADMIN_EMAIL=

# Rótulos opcionais em PDF/planilhas
VITE_INSTITUICAO_NOME=
VITE_ORGAO_NOME=

# Supabase — https://supabase.com/dashboard → Project Settings → API
# (só necessários com VITE_DATA_SOURCE=supabase)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
