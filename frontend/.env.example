# Fonte de dados: local (IndexedDB) ou supabase
VITE_DATA_SOURCE=local

# E-mail opcional aplicado ao bootstrap de gestor/admin no seed local
VITE_GESTOR_GOOGLE_EMAIL=

# Supabase — https://supabase.com/dashboard → Project Settings → API
# (só necessários com VITE_DATA_SOURCE=supabase)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Servidor LAN (produção): não edite à mão — use na raiz do repo:
#   Transferir para Servidor/servidor-lan/build-producao-lan.ps1
# Gera frontend/.env.production.local com VITE_SUPABASE_URL=http://<IP-LAN>:8080
# (mesma origem do Caddy: /auth, /rest, /storage, …)
