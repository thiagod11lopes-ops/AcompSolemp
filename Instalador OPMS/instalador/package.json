{
  "name": "acompopms-instalador",
  "version": "1.0.8",
  "private": true,
  "description": "Wizard de instalação AcompOPMS — Etapa 11",
  "main": "electron-main.mjs",
  "type": "module",
  "scripts": {
    "prepare-payload": "node scripts/prepare-payload.mjs",
    "prestart": "node scripts/prepare-payload.mjs",
    "prebuild": "node scripts/prepare-payload.mjs",
    "start": "electron .",
    "test:unit": "node scripts/run-unit-tests.mjs",
    "build": "electron-builder --config electron-builder.yml",
    "build:win": "electron-builder --config electron-builder.yml --win portable",
    "build:linux": "electron-builder --config electron-builder.yml --linux AppImage"
  },
  "devDependencies": {
    "electron": "^34.5.8",
    "electron-builder": "^25.1.8"
  }
}
